# Copia este archivo a .env.local y llena los valores desde tu proyecto de Supabase
# (Supabase Dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloca-aqui-tu-anon-key

# Solo para scripts de servidor/administración (NUNCA exponer al navegador)
SUPABASE_SERVICE_ROLE_KEY=coloca-aqui-tu-service-role-key
